# Copy this file to .streamlit/secrets.toml and fill in the values your
# bank's IT / identity team gives you. secrets.toml itself is gitignored —
# never commit real client secrets or the cookie_secret.
#
# Without this file present, the app falls back to a no-login local dev
# mode (see the `hasattr(st.user, "is_logged_in")` check in ui/app.py) —
# fine for your own laptop, NOT fine for anything reachable by other
# people, since without it there is no authentication at all.
#
# Streamlit's built-in auth (st.login/st.logout) speaks OIDC. Any
# identity provider that exposes an OIDC discovery document works:
# Azure AD / Microsoft Entra ID, Okta, Keycloak, ADFS (if OIDC is
# enabled), Google Workspace, etc. Ask IT for:
#   - the OIDC issuer / discovery URL (server_metadata_url below)
#   - a client_id + client_secret for an app registration they create
#     for RegIntel, with the redirect_uri below registered as the
#     allowed callback
#
# redirect_uri: this app's URL + "/oauth2callback". Update the host
# once this is deployed on the bank's server (not localhost).
# cookie_secret: any long random string, e.g. generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET"
client_id = "REPLACE_WITH_CLIENT_ID_FROM_IT"
client_secret = "REPLACE_WITH_CLIENT_SECRET_FROM_IT"
server_metadata_url = "REPLACE_WITH_YOUR_IDP_OIDC_DISCOVERY_URL"

# Examples of server_metadata_url by provider (fill in your {tenant} /
# {subdomain} — ask IT):
#
# Azure AD / Entra ID:
#   https://login.microsoftonline.com/{tenant}/v2.0/.well-known/openid-configuration
#
# Okta:
#   https://{subdomain}.okta.com/.well-known/openid-configuration
#
# Keycloak:
#   https://{keycloak-host}/realms/{realm}/.well-known/openid-configuration
